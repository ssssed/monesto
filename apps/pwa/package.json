{
  "name": "@monesto/pwa",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "homepage": "https://ssssed.github.io/monesto/",
  "scripts": {
    "dev": "vite --port 8193 --host",
    "build": "tsc --noEmit && vite build && node ./scripts/prepare-gh-pages.mjs",
    "preview": "vite preview --port 8193",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && npx --yes gh-pages@6 -d dist -b gh-pages --dotfiles"
  },
  "dependencies": {
    "@monesto/rune": "*",
    "@tanstack/react-router": "^1.131.27",
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-plugin": "^1.131.27",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.2",
    "vite": "^6.3.2",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.0"
  }
}
